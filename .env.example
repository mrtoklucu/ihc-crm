# Firebase proje ayarlari (Firebase Console > Proje Ayarlari > Web uygulamasi)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Platformun ana alan adi. Tenant subdomainleri bunun altinda cozulur.
# Ornek: acme.zbtcrmsys.com -> slug "acme"
VITE_APP_DOMAIN=zbtcrmsys.com

# Webhook / API cagrilarinin gittigi kok adres (genelde https://$VITE_APP_DOMAIN)
VITE_API_BASE_URL=https://zbtcrmsys.com

# Meta (Facebook) webhook dogrulama anahtari. functions/ tarafiyla ayni olmali.
VITE_META_VERIFY_TOKEN=zbtcrm_meta_v2026
